# Neon connection string for production/preview (Neon dashboard → Connect),
# or a local PGlite folder for development without a server:
DATABASE_URL=pglite://./.pglite
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Signs login sessions. Use a random string of 32+ characters (e.g. `openssl rand -base64 48`).
SESSION_SECRET=

# First admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@carshield.local
# Required (12+ characters) when seeding a real database; the local PGlite database falls back to ChangeMe123!
ADMIN_PASSWORD=
